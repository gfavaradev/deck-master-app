#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// google_mobile_ads 9.1.0 importa <GoogleMobileAds/GoogleMobileAds_Beta.h>, che in
// Google-Mobile-Ads-SDK 13.8.0 sta in PrivateHeaders/ (fuori dal module map).
// Serve anche qui, non solo nel post_install del Podfile: il modulo viene validato
// con le build settings del target Runner, non con quelle del pod.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
